<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://biblio.hybride_biblio.com/soap"
           xmlns:tns="http://biblio.hybride_biblio.com/soap"
           elementFormDefault="qualified">

    <xs:element name="AjouterLivreRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="titre" type="xs:string"/>
                <xs:element name="auteur" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="AjouterLivreResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="ModifierLivreRequest">
  <xs:complexType>
    <xs:sequence>
      <xs:element name="livreID" type="xs:long"/>
      <xs:element name="livre" type="tns:Livre"/>
    </xs:sequence>
  </xs:complexType>
</xs:element>

<xs:element name="ModifierLivreResponse">
  <xs:complexType>
    <xs:sequence>
      <xs:element name="status" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
</xs:element>


</xs:schema>
